{
  "name": "mission-control",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development node --max-old-space-size=8192 server.js",
    "build": "node ./node_modules/next/dist/bin/next build --experimental-build-mode compile",
    "start": "NODE_ENV=production node server.js",
    "lint": "eslint",
    "mc": "npx tsx scripts/mc.ts",
    "orchestration:migrate": "npx tsx scripts/orchestration-migrate.ts",
    "orchestration:seed": "npx tsx scripts/orchestration-seed.ts",
    "orchestration:cleanup": "npx tsx scripts/cleanup-test-artifacts.ts",
    "orchestration:cleanup:apply": "npx tsx scripts/cleanup-test-artifacts.ts --apply",
    "workspace:migration:inventory": "npx tsx scripts/workspace-migration.ts inventory",
    "workspace:migration:dry-run": "npx tsx scripts/workspace-migration.ts dry-run",
    "workspace:migration:snapshot": "npx tsx scripts/workspace-migration.ts snapshot",
    "workspace:migration:verify": "npx tsx scripts/workspace-migration.ts verify",
    "ideas:migrate-json-to-sqlite": "npx tsx scripts/ideas-json-to-sqlite.ts",
    "test:build-state": "node --import ./scripts/register-ts-paths.mjs src/lib/__tests__/build-state-terminal-transitions.test.ts",
    "test:orchestration:bridge": "ORCHESTRATION_DB_PATH=/tmp/orchestration-bridge-error-handling.db npx tsx src/lib/__tests__/orchestration-bridge-error-handling.test.ts",
    "test:orchestration:fire-agent": "ORCHESTRATION_DB_PATH=/tmp/orchestration-fire-agent.db npx tsx src/lib/__tests__/orchestration-fire-company-agent.test.ts",
    "test:orchestration:agent-creation-wiring": "ORCHESTRATION_DB_PATH=/tmp/orchestration-agent-creation-wiring.db npx tsx src/lib/__tests__/orchestration-agent-creation-wiring.test.ts",
    "test:orchestration:type-mappings": "ORCHESTRATION_DB_PATH=/tmp/orchestration-type-mappings.db npx tsx src/lib/__tests__/orchestration-type-mappings.test.ts",
    "test:orchestration:openclaw": "ORCHESTRATION_DB_PATH=/tmp/orchestration-openclaw-execution.db npx tsx src/lib/__tests__/orchestration-openclaw-execution.test.ts",
    "test:orchestration:heartbeat": "ORCHESTRATION_DB_PATH=/tmp/orchestration-openclaw-heartbeat.db npx tsx src/lib/__tests__/orchestration-openclaw-heartbeat.test.ts",
    "test:orchestration:company-heartbeats": "ORCHESTRATION_DB_PATH=/tmp/orchestration-company-heartbeats.db npx tsx src/lib/__tests__/orchestration-company-heartbeats-route.test.ts",
    "test:orchestration:heartbeat-settings": "npx tsx src/lib/__tests__/orchestration-heartbeat-settings-contract.test.ts",
    "test:orchestration:execution-heartbeat-bridge": "sh -c 'ORCHESTRATION_DB_PATH=\"/tmp/orchestration-execution-heartbeat-bridge-$$.db\" npx tsx src/lib/__tests__/orchestration-execution-heartbeat-bridge.test.ts'",
    "test:orchestration:openclaw-monitor": "ORCHESTRATION_DB_PATH=/tmp/orchestration-openclaw-session-monitoring.db npx tsx src/lib/__tests__/orchestration-openclaw-session-monitoring.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.58.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/rapier": "^2.2.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "date-fns": "^4.1.0",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.563.0",
    "next": "^16.2.2",
    "openai": "^6.33.0",
    "playwright": "^1.58.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "three": "^0.183.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "^4.3.6"
  }
}
