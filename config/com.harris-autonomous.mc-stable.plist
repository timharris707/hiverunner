<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.harris-autonomous.mc-stable</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-lc</string>
    <string>exec "$MC_APP_ROOT/scripts/run_stable_service.sh"</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PORT</key>
    <string>3001</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>MC_APP_ROOT</key>
    <string>/Users/timharris/.mission-control/app</string>
    <key>MC_LOG_DIR</key>
    <string>/Users/timharris/.mission-control/logs</string>
    <key>MC_ENGINE_TICK</key>
    <string>on</string>
    <key>MC_WORKSPACE_ROOT</key>
    <string>/Users/timharris/.mission-control/stable/workspaces</string>
    <key>MC_SWEEP_COMPANIES</key>
    <string>weather-edge-2</string>
    <key>MC_ORCHESTRATION_SWEEP</key>
    <string>0</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/timharris/.mission-control/logs/mission-control-stable.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/timharris/.mission-control/logs/mission-control-stable.err.log</string>
</dict>
</plist>
