# Henry Avatar — Pipecat + Tavus Backend
# Copy to .env and fill in values, or use start.sh to load from macOS Keychain.

# ─── Tavus (Avatar Video) ───────────────────────────────────────────
# We have this — loaded from keychain
TAVUS_API_KEY=
# Stock replica "Charlie" for now. Replace with custom Henry replica later.
TAVUS_REPLICA_ID=rf4703150052

# ─── Google / Gemini (LLM Brain) ────────────────────────────────────
# Gemini API key — we have this
GOOGLE_API_KEY=

# ─── Deepgram (Speech-to-Text) ──────────────────────────────────────
# NEEDED: Sign up at https://console.deepgram.com/
# Free tier: $200 credit, no CC required
DEEPGRAM_API_KEY=

# ─── Cartesia (Text-to-Speech) ──────────────────────────────────────
# NEEDED: Sign up at https://play.cartesia.ai/
# Free tier available
CARTESIA_API_KEY=

# ─── Daily.co (WebRTC Transport) ────────────────────────────────────
# NEEDED: Sign up at https://dashboard.daily.co/
# Free tier: 10,000 participant minutes/month
DAILY_API_KEY=

# ─── Server Config ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8108
