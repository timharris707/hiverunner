# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe (billing)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# OpenClaw (for advisory agent spawning)
# The openclaw CLI must be installed and configured

# OpenRouter (routes to Anthropic/OpenAI/Google models with one key)
OPENROUTER_API_KEY=sk-or-v1-xxx
# Optional override (defaults to https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
